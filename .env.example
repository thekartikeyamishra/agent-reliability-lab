# Copy to .env in the project folder (never commit it). Loaded automatically.
# NOT needed for the Agentplace task itself (recording + grading use no tokens).
# Only for: driving a model directly (--adapter openai), comparing models (models), the optional judge (--judge).

# --- Model under test: local Ollama = free, offline, no key ---
ARL_BASE_URLS=http://localhost:11434/v1
ARL_MODEL=llama3.2:3b
ARL_API_KEY=
ARL_TIMEOUT_MS=120000
ARL_RETRIES=2

# --- Optional judge (advisory; can never clear a rule failure). Leave ARL_JUDGE_MODEL empty to disable. ---
ARL_JUDGE_MODEL=
ARL_JUDGE_BASE_URLS=http://localhost:11434/v1
ARL_JUDGE_API_KEY=

# --- Optional generic webhook adapter (Agentplace has no public API, so leave empty) ---
ARL_HTTP_URL=
ARL_HTTP_REPLY_PATH=reply
ARL_HTTP_AUTH=
